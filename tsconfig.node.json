{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "allowSyntheticDefaultImports": true,
    "types": [
      "node"
    ],
    "outDir": ".tsbuild/node",
    "declaration": true,
    "emitDeclarationOnly": true
  },
  "include": [
    "vite.config.ts",
    "scripts",
    "playwright.config.ts",
    "src/model/types.ts"
  ]
}
